{
  "name": "setup-air",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A GitHub Action to set up Air.",
  "main": "dist/setup-air/index.cjs",
  "scripts": {
    "build": "tsc --noEmit",
    "format": "biome format --fix",
    "format-check": "biome format",
    "lint": "biome lint --fix",
    "package": "node scripts/build-dist.mjs",
    "all": "npm install && npm run build && npm run format && npm run lint && npm run package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/posit-dev/setup-air.git"
  },
  "keywords": [
    "actions",
    "action",
    "r",
    "air"
  ],
  "author": "@DavisVaughan",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/tool-cache": "^4.0.0",
    "@octokit/core": "^7.0.6",
    "@octokit/plugin-paginate-rest": "^16.0.0",
    "@octokit/plugin-rest-endpoint-methods": "^18.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.2"
  }
}
